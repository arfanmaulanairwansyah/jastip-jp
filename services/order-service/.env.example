# Salin file ini jadi .env, isi nilai asli, JANGAN commit .env ke git
# Di Docker: hostname = nama service di docker-compose, bukan localhost
PORT=3003
DATABASE_URL=postgres://postgres:postgres@order-db:5432/order_db
REDIS_URL=redis://redis:6379
USER_SERVICE_URL=http://user-service:3001
CATALOG_SERVICE_URL=http://catalog-service:3002
