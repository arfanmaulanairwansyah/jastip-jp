# Salin file ini jadi .env, isi nilai asli, JANGAN commit .env ke git
# Di Docker: hostname = nama service di docker-compose (user-db), bukan localhost
PORT=3001
DATABASE_URL=postgres://postgres:postgres@user-db:5432/user_db
JWT_SECRET=ganti_dengan_string_acak_minimal_32_karakter_ini
JWT_EXPIRES_IN=7d
