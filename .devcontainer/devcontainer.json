{
  "name": "TITIP.JP",
  "image": "mcr.microsoft.com/devcontainers/universal:2",
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {}
  },
  "postCreateCommand": "echo '✅ Environment siap. Jalankan: docker compose up --build -d'",
  "forwardPorts": [8080, 3000],
  "portsAttributes": {
    "8080": {
      "label": "TITIP.JP (nginx)",
      "onAutoForward": "openBrowser"
    },
    "3000": {
      "label": "TITIP.JP Gateway (langsung)"
    }
  }
}
